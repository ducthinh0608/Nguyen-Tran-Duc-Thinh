#!/bin/bash
/usr/sbin/groupadd cool
/usr/sbin/useradd -m Student
/usr/sbin/useradd -m zappaf
/usr/sbin/useradd -m -G cool foxr
echo "Student" | passwd --stdin Student
echo "zappaf" | passwd --stdin zappaf
echo "foxr" | passwd --stdin foxr
-chay setup.sh
chmod 0777 setup.sh
sudo ./setup.sh
sudo chmod 755 /home/Student /home/zappaf /home/foxr
